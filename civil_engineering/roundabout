<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>44th St. & W. Main Roundabout — Presentation</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: #0f0f13;
    color: #e8e8e8;
    font-family: 'Segoe UI', system-ui, sans-serif;
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  header {
    background: #1a1a24;
    border-bottom: 1px solid #2e2e3e;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }

  header h1 {
    font-size: 14px;
    font-weight: 500;
    color: #9090b0;
    letter-spacing: 0.03em;
  }

  .slide-counter {
    font-size: 13px;
    color: #6060a0;
    font-variant-numeric: tabular-nums;
  }

  .main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 16px;
    min-height: 0;
  }

  .nav-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 12px;
    color: #5050a0;
    transition: color 0.15s, transform 0.1s;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
  }

  .nav-btn:hover {
    color: #a0a0ff;
    background: #1e1e2e;
    transform: scale(1.08);
  }

  .nav-btn:active { transform: scale(0.96); }

  .nav-btn svg {
    width: 36px;
    height: 36px;
  }

  .slide-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
    position: relative;
  }

  .slide-img {
    max-width: 100%;
    max-height: calc(100vh - 140px);
    width: auto;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 8px 40px rgba(0,0,0,0.6);
    display: block;
    transition: opacity 0.25s ease;
  }

  .slide-img.fade-out { opacity: 0; }

  footer {
    background: #1a1a24;
    border-top: 1px solid #2e2e3e;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-shrink: 0;
  }

  .play-btn {
    background: #2e2e4e;
    border: 1px solid #4040a0;
    color: #a0a0ff;
    cursor: pointer;
    padding: 7px 20px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    transition: background 0.15s, border-color 0.15s;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .play-btn:hover {
    background: #3a3a60;
    border-color: #7070d0;
  }

  .progress-bar-wrap {
    flex: 1;
    max-width: 400px;
    height: 4px;
    background: #2e2e3e;
    border-radius: 2px;
    overflow: hidden;
    position: relative;
  }

  .progress-bar {
    height: 100%;
    background: #5050d0;
    border-radius: 2px;
    width: 0%;
    transition: none;
  }

  .progress-bar.animating {
    transition: width linear;
  }

  .slide-title {
    font-size: 12px;
    color: #6060a0;
    max-width: 260px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dot-row {
    display: flex;
    gap: 5px;
    align-items: center;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2e2e3e;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
  }

  .dot.active { background: #6060d0; transform: scale(1.3); }
  .dot:hover { background: #5050b0; }
</style>
</head>
<body>

<header>
  <h1>44th St. &amp; W. Main — Roundabout Intersection</h1>
  <span class="slide-counter" id="counter">1 / 11</span>
</header>

<div class="main">
  <button class="nav-btn" id="prevBtn" title="Previous slide">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>

  <div class="slide-wrap">
    <img class="slide-img" id="slideImg" src="" alt="Slide" />
  </div>

  <button class="nav-btn" id="nextBtn" title="Next slide">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>
</div>

<footer>
  <button class="play-btn" id="playBtn">
    <svg id="playIcon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg>
    <span id="playLabel">Play</span>
  </button>

  <div class="progress-bar-wrap">
    <div class="progress-bar" id="progressBar"></div>
  </div>

  <div class="dot-row" id="dotRow"></div>
</footer>

<script>
const SLIDES = ["data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,"];

const TITLES = ['44th St. and W. Main Roundabout Intersection', 'Design Brief', 'Decision Matrix', 'Slide 4', 'Alignment Drawing', 'Right of Way', 'Existing Drawing', 'Surface Drawing', 'Cross-Section Drawing', 'Erosion Control', 'Traffic Control'];

const DURATIONS = [5000, 15000, 15000, 15000, 15000, 15000, 15000, 15000, 15000, 15000, 15000];


let current = 0;
let playing = false;
let timer = null;
let progressStart = null;
let progressDuration = 0;
let rafId = null;

const img = document.getElementById('slideImg');
const counter = document.getElementById('counter');
const playBtn = document.getElementById('playBtn');
const playLabel = document.getElementById('playLabel');
const playIcon = document.getElementById('playIcon');
const progressBar = document.getElementById('progressBar');
const dotRow = document.getElementById('dotRow');

// Build dots
SLIDES.forEach((_, i) => {
  const d = document.createElement('div');
  d.className = 'dot' + (i === 0 ? ' active' : '');
  d.addEventListener('click', () => goTo(i));
  dotRow.appendChild(d);
});

function updateDots() {
  dotRow.querySelectorAll('.dot').forEach((d, i) => {
    d.className = 'dot' + (i === current ? ' active' : '');
  });
}

function showSlide(index, animate) {
  img.classList.add('fade-out');
  setTimeout(() => {
    current = index;
    img.src = SLIDES[current];
    counter.textContent = (current + 1) + ' / ' + SLIDES.length;
    updateDots();
    img.classList.remove('fade-out');
    if (playing) startProgress();
    else resetProgress();
  }, 200);
}

function goTo(index) {
  clearAuto();
  resetProgress();
  showSlide(index, false);
}

function next() {
  const n = (current + 1) % SLIDES.length;
  showSlide(n, true);
}

function prev() {
  clearAuto();
  resetProgress();
  const n = (current - 1 + SLIDES.length) % SLIDES.length;
  showSlide(n, false);
}

function resetProgress() {
  cancelAnimationFrame(rafId);
  progressBar.style.transition = 'none';
  progressBar.style.width = '0%';
}

function startProgress() {
  cancelAnimationFrame(rafId);
  progressBar.style.transition = 'none';
  progressBar.style.width = '0%';

  const dur = DURATIONS[current];
  progressStart = performance.now();
  progressDuration = dur;

  function tick(now) {
    const elapsed = now - progressStart;
    const pct = Math.min(elapsed / progressDuration * 100, 100);
    progressBar.style.width = pct + '%';
    if (pct < 100) {
      rafId = requestAnimationFrame(tick);
    } else {
      if (playing) {
        if (current < SLIDES.length - 1) {
          next();
        } else {
          stopPlay();
        }
      }
    }
  }
  rafId = requestAnimationFrame(tick);
}

function clearAuto() {
  playing = false;
  cancelAnimationFrame(rafId);
  clearTimeout(timer);
  playLabel.textContent = 'Play';
  playIcon.innerHTML = '<polygon points="5,3 19,12 5,21"/>';
}

function startPlay() {
  playing = true;
  playLabel.textContent = 'Stop';
  playIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
  startProgress();
}

function stopPlay() {
  playing = false;
  cancelAnimationFrame(rafId);
  clearTimeout(timer);
  playLabel.textContent = 'Play';
  playIcon.innerHTML = '<polygon points="5,3 19,12 5,21"/>';
  resetProgress();
}

playBtn.addEventListener('click', () => {
  if (playing) stopPlay();
  else startPlay();
});

document.getElementById('prevBtn').addEventListener('click', prev);
document.getElementById('nextBtn').addEventListener('click', () => {
  clearAuto();
  const n = (current + 1) % SLIDES.length;
  showSlide(n, false);
});

// keyboard
document.addEventListener('keydown', e => {
  if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
    clearAuto();
    const n = (current + 1) % SLIDES.length;
    showSlide(n, false);
  } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
    prev();
  } else if (e.key === ' ') {
    e.preventDefault();
    if (playing) stopPlay(); else startPlay();
  }
});

// init
img.src = SLIDES[0];
</script>
</body>
</html>
